# Copy to .env before running:  cp .env.example .env   (Windows: copy .env.example .env)

# SQLite file, relative to the prisma/ folder (gitignored)
DATABASE_URL="file:./dev.db"

# Admin account created by `npm run db:seed`.
# These are documented placeholder defaults for LOCAL use only - change them.
ADMIN_EMAIL="admin@school.example"
ADMIN_PASSWORD="ChangeMe-Admin-2026"

# Password given to the fictional demo parents/teachers created by the seed.
# Set SEED_DEMO="false" to skip creating demo accounts.
DEMO_PASSWORD="ChangeMe-Demo-2026"
SEED_DEMO="true"

# Session lifetime in days
SESSION_DAYS="7"

# Public URL used for sitemap, canonical links and Open Graph
SITE_URL="http://localhost:3114"
